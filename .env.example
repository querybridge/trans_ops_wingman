# Transportation Operations Wingman: environment template.
# Copy to .env (git-ignored) and fill in. Never commit real values.
# See SETUP_CREDENTIALS.md for where each value comes from.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Fixed demo clock (timezone-aware ISO 8601); the app never uses the real clock for rules
DEMO_AS_OF=2026-10-21T15:00:00-04:00

# --- Pinecone (vector retrieval) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=ops-wingman
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Hugging Face Inference Providers (embeddings) ---
HF_TOKEN=
HF_EMBEDDING_PROVIDER=hf-inference
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Must match the Pinecone index dimension; verified at ingest and query time
EMBEDDING_DIMENSIONS=384

# --- Hosted LLM (explanations and briefings) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=30
# low | medium | high: higher effort is slower and costs more
LLM_EFFORT=medium
# Briefings restate rule results and cited procedures; low effort halves their latency
LLM_BRIEFING_EFFORT=low
LLM_MAX_TOKENS=8000

# --- LangSmith (optional tracing / evaluation) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ops-wingman
